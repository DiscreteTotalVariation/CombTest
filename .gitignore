# Compiled C binaries
ct_save
ct_c

# Python
__pycache__/
*.pyc

# Data: the exact and fitted grids are far too large for git (~144 GB in
# total). Fetch them with code/download_data.py, or recompute them with
# code/pipeline.sh --from-scratch. The small result files that the paper's
# numbers are read from are tracked, so every printed number can be checked
# without recomputing anything.
data/exact_distributions/*.txt
data/cdf_exact/*.txt
data/fitted/cvm_*/*.txt
data/*.npy
data/*.zip

# Paper output
paper/img/*.png

# OS
.DS_Store
Thumbs.db
